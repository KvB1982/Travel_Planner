# Kopieren nach .env und ausfüllen. Die Datei .env wird nicht ins Repository übernommen.

# Passwort der Datenbank, frei wählbar, lang und zufällig
POSTGRES_PASSWORD=
# Öffentliche Adresse der API, zum Beispiel https://reisen.<tailnet>.ts.net
PUBLIC_BASE_URL=
# Einmaliges Geheimnis für das Anlegen des ersten Kontos, mindestens 24 Zeichen.
# Nach der Einrichtung leeren und den Stack neu starten.
BOOTSTRAP_SECRET=
# Schlüssel für die KI-Übersetzung in den Steckbrief (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: Link zum Laden der App über TestFlight, erscheint auf der Einladungsseite.
TESTFLIGHT_URL=
# Optional: Tageslimits je Person (Vorgabe 400 Auswertungen, 30 Suchen).
DAILY_READINGS=
DAILY_SEARCHES=
